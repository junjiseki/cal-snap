{
  "$schema": "https://biomejs.dev/schemas/2.4.13/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "app/**/*.{js,jsx,ts,tsx,mts,cts,json,jsonc}",
      "components/**/*.{js,jsx,ts,tsx,mts,cts,json,jsonc}",
      "lib/**/*.{js,jsx,ts,tsx,mts,cts,json,jsonc}",
      "tests/**/*.{js,jsx,ts,tsx,mts,cts,json,jsonc}",
      "scripts/**/*.{js,jsx,ts,tsx,mts,cts,json,jsonc}",
      "*.{js,jsx,ts,tsx,mts,cts,json,jsonc}"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentWidth": 2,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useImportType": "off" // 型専用import (import type) を強制するルールを無効化。
      },
      "correctness": {
        "useUniqueElementIds": "on", // 各input要素などで一意のidを強制。
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn",
        "noUnusedFunctionParameters": "warn",
        "noNestedComponentDefinitions": "warn",
        "useExhaustiveDependencies": "warn"
      },
      "a11y": {
        "noLabelWithoutControl": "off",
        "useButtonType": "off",
        "useAriaPropsSupportedByRole": "off",
        "noStaticElementInteractions": "off",
        "useKeyWithClickEvents": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noArrayIndexKey": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "quoteProperties": "preserve"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "off" // import文の自動整理機能を無効化。
      }
    }
  },
  "overrides": [
    {
      "includes": ["components/meals/meal-photo-analyzer.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    }
  ]
}
