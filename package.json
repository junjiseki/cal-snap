{
  "name": "diet-app",
  "version": "0.1.0",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "@google/genai",
      "@prisma/engines",
      "esbuild",
      "msw",
      "prisma",
      "protobufjs",
      "sharp",
      "supabase",
      "unrs-resolver",
      "workerd"
    ]
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "ci": "biome ci .",
    "pwa:maskable-icons": "node scripts/generate-pwa-maskable-icons.mjs",
    "typecheck": "prisma generate && tsc --noEmit && tsc --noEmit -p prisma/tsconfig.json",
    "db:seed": "prisma db seed",
    "db:types": "prisma generate",
    "db:migrate:new": "supabase migration new",
    "db:migrate:push": "supabase db push --local",
    "sb:start": "supabase start",
    "sb:stop": "supabase stop",
    "sb:status": "supabase status"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@google/genai": "^1.51.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
