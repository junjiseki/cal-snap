{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["./seed.ts", "../app/generated/prisma/**/*.ts"]
}
